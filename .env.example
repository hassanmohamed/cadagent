# Copy this file to .env and fill in the key to turn on AI reading.
# Without a key the demo runs in "offline demo mode" (bundled test files only).
ANTHROPIC_API_KEY=

# Optional: use a different Claude model for reading (default: claude-opus-5-5).
# CADAGENT_MODEL=claude-opus-5-5

# Optional: ask for this password before showing the Streamlit app (use it when hosted).
# APP_PASSWORD=
